{
  "name": "cyprus-weather",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test mobile/tests/*.test.js",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "ios:add": "npm install @capacitor/ios@8 && npm run build && cap add ios"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "echarts": "^6.0.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "vite": "^7.0.0"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
    }
  }
}
