# Paths below belong to the existing aranet4 service on the server (its user, virtualenv,
# public weather DB and AI directory). They are shared resources: keep them as they are.
[Unit]
Description=Kairo rain radar frames from CyDoM raw volumes
After=network-online.target
Wants=network-online.target
[Service]
User=aranet
WorkingDirectory=/opt/cyprus-weather
# Own virtualenv with h5py, numpy and Pillow (backend/requirements-radar.txt); the API does not need them.
ExecStart=/opt/cyprus-weather/.venv-radar/bin/python backend/radar.py --dir /var/lib/cyprus-weather/radar --loop
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/cyprus-weather
[Install]
WantedBy=multi-user.target
