# Paths below belong to the existing aranet4 service on the server (its user, virtualenv,
# public weather DB and AI directory). They are shared resources: keep them as they are.
[Unit]
Description=Sync existing public weather history and hourly model
After=network-online.target
Wants=network-online.target
[Service]
User=aranet
WorkingDirectory=/opt/cyprus-weather
ExecStart=/opt/aranet4/.venv/bin/python backend/sync_server.py --source /home/aranet/weather/weather.db --db /var/lib/cyprus-weather/weather.db --loop
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/cyprus-weather
# The aranet4 DB is WAL: a read-only reader still has to create weather.db-shm next to it.
ReadWritePaths=/home/aranet/weather
[Install]
WantedBy=multi-user.target
